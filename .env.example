# ---------------------------------------------------------------------------
# FRONTEND (repo root .env) — loaded by Vite.
#
# Every VITE_* value is inlined into the browser bundle and is readable by
# anyone who opens the page. Only publishable/anon keys belong here. Never put
# a Supabase service-role key or any LLM API key in this file.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
