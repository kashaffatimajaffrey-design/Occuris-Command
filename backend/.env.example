# ---------------------------------------------------------------------------
# BACKEND (backend/.env) — server-side only, never exposed to the browser.
# ---------------------------------------------------------------------------

# Supabase. SUPABASE_KEY is the name the code reads (database.py); a
# service-role key belongs here and only here.
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# LLM provider. One of: ollama | claude | groq
# ollama is the development default and needs no API key, only a running
# daemon. See backend/llm.py.
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# Optional second provider, tried only if LLM_PROVIDER fails. Leave empty for
# no fallback. When it is used the answer is flagged degraded and reports the
# provider that actually replied — a fallback answer is never presented as a
# primary one.
LLM_FALLBACK_PROVIDER=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Live feeds (backend/live_feeds.py, backend/risk.py). All optional — each
# endpoint reports the feature as unavailable when its key is absent rather
# than substituting data.
# ---------------------------------------------------------------------------
NEWS_API_KEY=
OPENWEATHER_API_KEY=
SUPPLIER_API_KEY=

# ---------------------------------------------------------------------------
# SAP OData (material master).
# UNVERIFIED: this integration has never run against a real SAP system.
# Setting these enables the code path; it does not make it proven.
# See backend/sap_client.py for the known gaps before relying on it.
# ---------------------------------------------------------------------------
SAP_ODATA_URL=
SAP_USERNAME=
SAP_PASSWORD=
